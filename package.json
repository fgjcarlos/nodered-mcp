{
  "name": "@fgjcarlos/nodered-mcp",
  "version": "0.7.2",
  "description": "MCP server for Node-RED — installable via npm",
  "license": "MIT",
  "repository": "github:fgjcarlos/nodered-mcp",
  "homepage": "https://github.com/fgjcarlos/nodered-mcp#readme",
  "bugs": "https://github.com/fgjcarlos/nodered-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "node-red",
    "nodered",
    "llm"
  ],
  "bin": {
    "nodered-mcp": "bin/nodered-mcp.js"
  },
  "files": [
    "bin/",
    "!bin/*_test.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "//": "optionalDependencies pinned to the same exact version as the main package. npm's own os/cpu filter on each platform package selects exactly one at install time, replacing the legacy postinstall downloader (#257).",
  "optionalDependencies": {
    "@fgjcarlos/nodered-mcp-win32-x64": "0.7.2",
    "@fgjcarlos/nodered-mcp-win32-arm64": "0.7.2",
    "@fgjcarlos/nodered-mcp-linux-x64": "0.7.2",
    "@fgjcarlos/nodered-mcp-linux-arm64": "0.7.2",
    "@fgjcarlos/nodered-mcp-darwin-x64": "0.7.2",
    "@fgjcarlos/nodered-mcp-darwin-arm64": "0.7.2"
  }
}
