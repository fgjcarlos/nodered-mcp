# Base URL of the Node-RED admin API
NODERED_URL=http://localhost:1880

# Bearer token (if admin auth is enabled in Node-RED)
NODERED_TOKEN=

# Basic auth (alternative to the token)
NODERED_USERNAME=
NODERED_PASSWORD=

# Skip TLS verification (do not use in production)
NODERED_INSECURE=false

# Where to write flow snapshots before every mutating operation
NODERED_BACKUP_DIR=backups

# Logging
MCP_LOG_LEVEL=info

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio

# Listen address for the http transport (ignored on stdio)
MCP_HTTP_ADDR=:8090

# Bearer token for the http transport. Mandatory when the listen
# address is reachable from outside this machine; optional for
# loopback binds. Mutually exclusive with MCP_OAUTH_ISSUER.
MCP_HTTP_TOKEN=

# OAuth 2.1 / OIDC issuer URL. When set, every http request must
# carry a JWT-bearer issued by this provider, signed by a key
# advertised at <issuer>/.well-known/jwks.json, with iss equal to
# this value and aud equal to MCP_OAUTH_AUDIENCE. Discovery happens
# at startup, so a misconfigured URL fails fast. Mutually exclusive
# with MCP_HTTP_TOKEN.
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=

MCP_READ_ONLY=false
