# Base URL of the Node-RED admin API
NODERED_URL=http://localhost:1880

# Bearer token (if admin auth is enabled in Node-RED)
NODERED_TOKEN=

# Basic auth (alternative to the token)
NODERED_USERNAME=
NODERED_PASSWORD=

# Skip TLS verification (do not use in production)
NODERED_INSECURE=false

# Where to write flow snapshots before every mutating operation
NODERED_BACKUP_DIR=backups

# Logging
MCP_LOG_LEVEL=info

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio

# Listen address for the http transport (ignored on stdio)
MCP_HTTP_ADDR=:8090
